{
  "openapi": "3.0.3",
  "info": {
    "title": "OrderFlow API",
    "version": "1.4.2",
    "description": "API interna de OrderFlow para gestión de clientes, pedidos, productos, stock, envíos y facturación."
  },
  "servers": [
    { "url": "http://127.0.0.1:5000", "description": "Entorno local" }
  ],
  "tags": [
    { "name": "Auth", "description": "Autenticación y perfil" },
    { "name": "Clientes" },
    { "name": "Productos" },
    { "name": "Pedidos" },
    { "name": "Envíos" },
    { "name": "Facturación" },
    { "name": "Administración" },
    { "name": "Meta" }
  ],
  "paths": {
    "/api/health": {
      "get": { "tags": ["Meta"], "summary": "Estado del servicio", "responses": { "200": { "description": "OK" } } }
    },
    "/api/version": {
      "get": { "tags": ["Meta"], "summary": "Versión de la API", "responses": { "200": { "description": "OK" } } }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"], "summary": "Iniciar sesión",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object",
            "properties": { "username": { "type": "string" }, "password": { "type": "string" } },
            "required": ["username", "password"]
          } } }
        },
        "responses": { "200": { "description": "Sesión iniciada" }, "401": { "description": "Credenciales inválidas" } }
      }
    },
    "/api/auth/logout": {
      "post": { "tags": ["Auth"], "summary": "Cerrar sesión", "responses": { "200": { "description": "OK" } } }
    },
    "/api/auth/me": {
      "get": { "tags": ["Auth"], "summary": "Usuario actual", "responses": { "200": { "description": "OK" }, "401": { "description": "No autenticado" } } }
    },
    "/api/profile": {
      "get": { "tags": ["Auth"], "summary": "Ver perfil", "responses": { "200": { "description": "OK" } } },
      "put": {
        "tags": ["Auth"], "summary": "Actualizar perfil",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "full_name": { "type": "string" } } } } } },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/clients": {
      "get": { "tags": ["Clientes"], "summary": "Listar clientes", "responses": { "200": { "description": "OK" }, "403": { "description": "Requiere administrador" } } }
    },
    "/api/clients/{id}": {
      "get": {
        "tags": ["Clientes"], "summary": "Obtener cliente",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": { "200": { "description": "OK" }, "403": { "description": "No autorizado" }, "404": { "description": "No encontrado" } }
      }
    },
    "/api/products": {
      "get": { "tags": ["Productos"], "summary": "Listar productos", "responses": { "200": { "description": "OK" } } }
    },
    "/api/products/{id}": {
      "get": {
        "tags": ["Productos"], "summary": "Obtener producto",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": { "200": { "description": "OK" }, "404": { "description": "No encontrado" } }
      }
    },
    "/api/products/search": {
      "get": {
        "tags": ["Productos"], "summary": "Buscar productos por nombre o SKU",
        "parameters": [ { "name": "q", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Texto a buscar" } ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/stock": {
      "get": { "tags": ["Productos"], "summary": "Niveles de stock", "responses": { "200": { "description": "OK" }, "403": { "description": "Requiere administrador" } } }
    },
    "/api/orders": {
      "get": { "tags": ["Pedidos"], "summary": "Listar pedidos del cliente", "responses": { "200": { "description": "OK" } } },
      "post": {
        "tags": ["Pedidos"], "summary": "Crear pedido",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "notes": { "type": "string" } } } } } },
        "responses": { "201": { "description": "Creado" } }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "tags": ["Pedidos"], "summary": "Detalle de pedido",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": { "200": { "description": "OK" }, "404": { "description": "No encontrado" } }
      }
    },
    "/api/orders/{id}/items": {
      "get": {
        "tags": ["Pedidos"], "summary": "Renglones del pedido",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/orders/search": {
      "get": {
        "tags": ["Pedidos"], "summary": "Buscar pedidos propios por estado",
        "parameters": [ { "name": "status", "in": "query", "required": false, "schema": { "type": "string" } } ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/shipments": {
      "get": { "tags": ["Envíos"], "summary": "Listar envíos", "responses": { "200": { "description": "OK" }, "403": { "description": "Requiere administrador" } } }
    },
    "/api/shipments/{id}": {
      "get": {
        "tags": ["Envíos"], "summary": "Obtener envío",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": { "200": { "description": "OK" }, "403": { "description": "No autorizado" } }
      }
    },
    "/api/invoices": {
      "get": { "tags": ["Facturación"], "summary": "Listar facturas", "responses": { "200": { "description": "OK" }, "403": { "description": "Requiere administrador" } } }
    },
    "/api/invoices/{id}": {
      "get": {
        "tags": ["Facturación"], "summary": "Obtener factura",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": { "200": { "description": "OK" }, "403": { "description": "No autorizado" } }
      }
    },
    "/api/admin/orders": {
      "get": { "tags": ["Administración"], "summary": "Listar todos los pedidos", "responses": { "200": { "description": "OK" }, "403": { "description": "Requiere administrador" } } }
    },
    "/api/admin/orders/{id}": {
      "post": {
        "tags": ["Administración"], "summary": "Actualizar un pedido (estado, notas, total)",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "requestBody": { "content": { "application/json": { "schema": {
          "type": "object",
          "properties": { "status": { "type": "string" }, "notes": { "type": "string" }, "total": { "type": "number" } }
        } } } },
        "responses": { "200": { "description": "Pedido actualizado" }, "404": { "description": "No encontrado" } }
      }
    },
    "/api/admin/users": {
      "get": { "tags": ["Administración"], "summary": "Listar usuarios", "responses": { "200": { "description": "OK" }, "403": { "description": "Requiere administrador" } } }
    },
    "/api/admin/stats": {
      "get": { "tags": ["Administración"], "summary": "Métricas del sistema", "responses": { "200": { "description": "OK" }, "403": { "description": "Requiere administrador" } } }
    }
  }
}
